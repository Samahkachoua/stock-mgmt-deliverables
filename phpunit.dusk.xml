<?xml version="1.0" encoding="UTF-8"?>
<!-- Browser tests: `npm run build`, then `php artisan dusk`. See tests/DuskTestCase.php. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://127.0.0.1:8090" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- The same local test database as phpunit.xml: never the development
             or the hosted database. The app under test is started with it too. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="54322" force="true"/>
        <env name="DB_DATABASE" value="stock_test" force="true"/>
        <env name="DB_USERNAME" value="postgres" force="true"/>
        <env name="DB_PASSWORD" value="postgres" force="true"/>
        <env name="DB_SSLMODE" value="prefer" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <!-- The same again for $_SERVER: `php artisan dusk` hands the test process the values of
             .env in its environment, and Laravel reads $_SERVER before $_ENV. Without these the
             tests would run against the development database. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_URL" value="http://127.0.0.1:8090" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="DB_HOST" value="127.0.0.1" force="true"/>
        <server name="DB_PORT" value="54322" force="true"/>
        <server name="DB_DATABASE" value="stock_test" force="true"/>
        <server name="DB_USERNAME" value="postgres" force="true"/>
        <server name="DB_PASSWORD" value="postgres" force="true"/>
        <server name="DB_SSLMODE" value="prefer" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
